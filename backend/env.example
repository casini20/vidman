# Copy to .env and fill in values

# URL of your frontend (Vercel URL) — used for CORS
FRONTEND_URL=https://your-app.vercel.app

# Where to store uploaded videos
UPLOADS_DIR=uploads

# Path to the SQLite database file
DB_PATH=tiktok_manager.db

# Set to "false" to see the browser (useful for debugging on a local machine)
HEADLESS=true
